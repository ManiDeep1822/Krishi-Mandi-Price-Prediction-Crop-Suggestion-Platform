# ==============================================================================
# Krishi Mandi Price Prediction & Crop Suggestion Platform
# Environment Configuration Template (Vercel & Local Development)
# ==============================================================================

# 1. Government of India Open Data Platform API Key (Agmarknet Live Mandi Feed)
# Obtain from: https://data.gov.in/
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# 2. Google Gemini Generative AI API Key
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Enterprise Administrative Passcode (Controls /api/config write access)
# Required to save/update runtime API configuration securely
ADMIN_SECRET_KEY=your_secure_admin_passcode_here
